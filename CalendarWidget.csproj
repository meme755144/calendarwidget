<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CalendarWidget</AssemblyName>
    <RootNamespace>CalendarWidget</RootNamespace>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- tests 資料夾裡是獨立的測試專案，不能被編進小工具本體 -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
    <ApplicationDefinition Remove="tests\**" />
  </ItemGroup>

  <!-- 專案資料夾裡有 google-client.json 就把它包進程式（內建 Google 用戶端），沒有就不包 -->
  <ItemGroup Condition="Exists('google-client.json')">
    <EmbeddedResource Include="google-client.json" LogicalName="google-client.json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Security" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
