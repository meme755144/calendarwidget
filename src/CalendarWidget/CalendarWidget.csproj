<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CalendarWidget</AssemblyName>
    <RootNamespace>CalendarWidget</RootNamespace>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- 輸出放在倉庫根目錄的 bin\（跟搬資料夾之前一樣），exe 路徑不變 -->
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\..\bin\</BaseOutputPath>
  </PropertyGroup>

  <!-- 專案資料夾裡有 google-client.json 就把它包進程式（內建 Google 用戶端），沒有就不包 -->
  <ItemGroup Condition="Exists('google-client.json')">
    <EmbeddedResource Include="google-client.json" LogicalName="google-client.json" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Security" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

</Project>
