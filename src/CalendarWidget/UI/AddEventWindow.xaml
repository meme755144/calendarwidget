<Window x:Class="CalendarWidget.AddEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增行程"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Microsoft JhengHei UI" FontSize="14"
        Background="#F3F4F8">
    <Window.Resources>
        <!-- 日期選擇的彈出月曆預設很小：整個放大 -->
        <Style x:Key="BigCalendar" TargetType="Calendar">
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1.3" ScaleY="1.3" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="CalendarStyle" Value="{StaticResource BigCalendar}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18,22,18">
        <TextBlock Text="標題" FontWeight="SemiBold" />
        <TextBox x:Name="TitleBox" Margin="0,6,0,14" Padding="6,5" FontSize="15" MaxLength="200" />

        <!-- 跟 Google 日曆一樣：開始日期＋開始時間，到，結束日期＋結束時間 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="開始" FontWeight="SemiBold" VerticalAlignment="Center" />
            <DatePicker x:Name="DateBox" Grid.Row="0" Grid.Column="1" />
            <ComboBox x:Name="StartBox" Grid.Row="0" Grid.Column="2" IsEditable="True" Width="110" Margin="10,0,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="結束" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,10,0,0" />
            <DatePicker x:Name="EndDateBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" />
            <ComboBox x:Name="EndBox" Grid.Row="1" Grid.Column="2" IsEditable="True" Width="110" Margin="10,10,0,0" />
        </Grid>
        <CheckBox x:Name="AllDayBox" Content="全天" Margin="44,12,0,0" />

        <TextBlock x:Name="CalendarLabel" Text="放進哪個日曆" FontWeight="SemiBold" Margin="0,16,0,0" />
        <ComboBox x:Name="CalendarBox" Margin="0,6,0,0" />
        <TextBlock x:Name="NoticeText" Foreground="#666" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" />

        <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CopyUrlButton" Content="複製授權網址" Padding="12,5" Margin="0,0,8,0" Visibility="Collapsed" />
            <Button x:Name="AddButton" Content="新增" Width="90" Padding="0,5" Margin="0,0,8,0" IsDefault="True" />
            <Button x:Name="CancelButton" Content="取消" Width="90" Padding="0,5" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
