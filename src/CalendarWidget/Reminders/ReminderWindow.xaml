<Window x:Class="CalendarWidget.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="節日提醒"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft JhengHei UI"
        UseLayoutRounding="True">
    <Border CornerRadius="12" Padding="18,16,18,16" Background="#F21E1E2E" BorderBrush="#5B8DEF" BorderThickness="1.5" MinWidth="280" MaxWidth="360">
        <StackPanel>
            <TextBlock x:Name="HeadText" FontSize="16" FontWeight="SemiBold" Foreground="#F5F5FF" />
            <TextBlock x:Name="DateText" FontSize="12" Foreground="#9A9AB4" Margin="0,2,0,10" />
            <StackPanel x:Name="ItemList" Margin="0,0,0,14" />
            <StackPanel Orientation="Horizontal">
                <Border x:Name="AckButton" Background="#5B8DEF" CornerRadius="6" Padding="22,6" Margin="0,0,10,0" Cursor="Hand">
                    <TextBlock x:Name="AckText" Text="好" FontSize="13" Foreground="White" />
                </Border>
                <Border x:Name="SnoozeButton" Background="#33FFFFFF" CornerRadius="6" Padding="14,6" Cursor="Hand">
                    <TextBlock x:Name="SnoozeText" FontSize="13" Foreground="#E8E8F4" />
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
